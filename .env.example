# Copiar este archivo a .env.local y reemplazar con los valores reales
# de Supabase -> Settings -> API. NUNCA poner acá la Service Role Key,
# solo la ANON KEY (esta sí es segura de exponer en el frontend, la
# protección real la da RLS).

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_AQUI
